        {
          "name": "Gerar Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    const resposta = pm.response.json();\r",
                  "    \r",
                  "    // Salva globalmente (independe de Environment selecionado)\r",
                  "    pm.globals.set(\"jwt_token\", resposta.token);\r",
                  "    \r",
                  "    console.log(\"Token salvo globalmente: \" + resposta.token);\r",
                  "} else {\r",
                  "    console.log(\"Falha no login, token não atualizado.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
